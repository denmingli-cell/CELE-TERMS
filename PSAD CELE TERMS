        { term: "Re-Entrant Corner Irregularity", def: "Plan projections beyond re-entrant corner are > 15% of plan dimension.", category: "Horizontal Irregularities", hook: "L-shaped or T-shaped buildings flexing at inner corners." },
        { term: "Diaphragm Discontinuity Irregularity", def: "Diaphragms with cutouts > 50% gross area or stiffness change > 50% between stories.", category: "Horizontal Irregularities", hook: "Big hole in the floor slab (>50%)." },
