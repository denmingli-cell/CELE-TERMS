        { term: "Non-Parallel Systems Irregularity", def: "Vertical lateral resisting elements not parallel or symmetric to major orthogonal axes.", category: "Horizontal Irregularities", hook: "Angled/skewed structural walls." },
        { term: "Resultant Force", def: "Single force determining whether a body remains in equilibrium or accelerates.", category: "Past Board Exam Questions", hook: "Vector sum of all forces acting on an object." },
        { term: "Hooke's Law", def: "Principle stating stress is directly proportional to strain within the elastic region.", category: "Past Board Exam Questions", hook: "σ = E · ε (Linear elasticity)." },
        { term: "Poisson's Ratio", def: "The constant ratio of lateral strain to longitudinal (axial) strain.", category: "Past Board Exam Questions", hook: "Ratio of side squish vs axial stretch." },
        { term: "Young's Modulus", def: "Constant of proportionality defining linear relationship between stress and strain.", category: "Past Board Exam Questions", hook: "Slope of stress-strain line (Modulus of Elasticity)." },
        { term: "Column", def: "Member with unsupported height to least dimension ratio ≥ 3 used primarily for axial compression.", category: "Past Board Exam Questions", hook: "Height/Width ≥ 3 carrying axial weight." },
        { term: "Kinetic Friction", def: "Retarding contact force acting opposite to the direction of motion.", category: "Past Board Exam Questions", hook: "Friction sliding resistance." },
        { term: "Proportional Limit", def: "Stress value beyond which stress-strain relationship ceases to be a straight line.", category: "Past Board Exam Questions", hook: "Upper boundary of straight Hooke's Law line." },
        { term: "Pre-Tensioning", def: "Stressing high-strength steel tendons BEFORE concrete is poured.", category: "Past Board Exam Questions", hook: "Tension steel first, pour concrete second." },
        { term: "Post-Tensioning", def: "Stressing high-strength steel tendons AFTER concrete is poured and cured.", category: "Past Board Exam Questions", hook: "Pour concrete first, tension steel second inside ducts." },
        { term: "Relaxation", def: "Loss of stress over time in prestressed steel held at constant strain.", category: "Past Board Exam Questions", hook: "Steel tendons losing tension stress over time." },
        { term: "Orthotropic Material", def: "Has uniform composition but different elastic properties in orthogonal (perpendicular) directions.", category: "Past Board Exam Questions", hook: "Example: Plywood (different axial vs transverse strength)." },
        { term: "Factor of Safety", def: "Ratio of ultimate/failure stress to allowable design stress.", category: "Additional Mechanics Terms", hook: "Margin of safety ratio (Failure / Allowable)." }
    ];

    // Web Audio Synthesizer Sound System
    let audioCtx = null;

    function playSound(type) {
        if (!document.getElementById('sound-toggle').checked) return;
        
        if (!audioCtx) {
            audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        }
        if (audioCtx.state === 'suspended') {
            audioCtx.resume();
        }

        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        const now = audioCtx.currentTime;

        if (type === 'flip') {
            osc.type = 'sine';
            osc.frequency.setValueAtTime(250, now);
            osc.frequency.exponentialRampToValueAtTime(120, now + 0.08);
            gain.gain.setValueAtTime(0.15, now);
            gain.gain.exponentialRampToValueAtTime(0.01, now + 0.08);
            osc.start(now);
            osc.stop(now + 0.08);
        } else if (type === 'correct') {
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(523.25, now); // C5
            osc.frequency.setValueAtTime(659.25, now + 0.08); // E5
            osc.frequency.setValueAtTime(783.99, now + 0.16); // G5
            gain.gain.setValueAtTime(0.2, now);
            gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3);
            osc.start(now);
            osc.stop(now + 0.3);
        } else if (type === 'wrong') {
            osc.type = 'sawtooth';
            osc.frequency.setValueAtTime(180, now);
            osc.frequency.setValueAtTime(130, now + 0.1);
            gain.gain.setValueAtTime(0.25, now);
            gain.gain.exponentialRampToValueAtTime(0.01, now + 0.25);
            osc.start(now);
            osc.stop(now + 0.25);
        } else if (type === 'click') {
            osc.type = 'sine';
            osc.frequency.setValueAtTime(400, now);
            gain.gain.setValueAtTime(0.08, now);
            gain.gain.exponentialRampToValueAtTime(0.01, now + 0.04);
            osc.start(now);
            osc.stop(now + 0.04);
        }
    }

    // App State Variables
    let userName = "";
    let activeDeck = [];
    let currentIndex = 0;
    let score = 0;
    let currentMode = "fc"; // 'fc' or 'quiz'
    
    // Timer Variables
    let timerInterval = null;
    let secondsElapsed = 0;

    function startTimer() {
        stopTimer();
        secondsElapsed = 0;
        updateTimerDisplay();
        timerInterval = setInterval(() => {
            secondsElapsed++;
            updateTimerDisplay();
        }, 1000);
    }

    function stopTimer() {
        if (timerInterval) {
            clearInterval(timerInterval);
            timerInterval = null;
        }
    }

    function formatTime(totalSec) {
        const mins = Math.floor(totalSec / 60);
        const secs = totalSec % 60;
        return `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
    }

    function updateTimerDisplay() {
        document.getElementById('timer-display').innerText = `⏱️ ${formatTime(secondsElapsed)}`;
    }

    function initSession() {
        const nameInput = document.getElementById('user-name').value.trim();
        if (!nameInput) {
            alert("Please enter your name before continuing!");
            return;
        }

        userName = nameInput;
        document.getElementById('display-user-name').innerText = userName;

        const countChoice = document.getElementById('item-count').value;
        let shuffled = [...rawData].sort(() => 0.5 - Math.random());

        if (countChoice === 'all') {
            activeDeck = shuffled;
        } else {
            activeDeck = shuffled.slice(0, parseInt(countChoice));
        }

        currentIndex = 0;
        score = 0;
        currentMode = document.getElementById('study-mode').value;

        document.getElementById('screen-setup').classList.add('hidden');
        document.getElementById('screen-summary').classList.add('hidden');
        document.getElementById('screen-study').classList.remove('hidden');

        playSound('click');
        startTimer();
        switchMode(currentMode);
    }

    function switchMode(mode) {
        currentMode = mode;
        document.getElementById('tab-fc').classList.toggle('active', mode === 'fc');
        document.getElementById('tab-quiz').classList.toggle('active', mode === 'quiz');

        document.getElementById('view-flashcard').classList.toggle('hidden', mode !== 'fc');
        document.getElementById('view-quiz').classList.toggle('hidden', mode !== 'quiz');

        playSound('click');
        renderCurrentItem();
    }

    function updateProgress() {
        document.getElementById('progress-indicator').innerText = `${currentIndex + 1} / ${activeDeck.length}`;
    }

    function renderCurrentItem() {
        if (currentIndex >= activeDeck.length) {
            finishSession();
            return;
        }

        updateProgress();

        if (currentMode === 'fc') {
            const card = activeDeck[currentIndex];
            document.getElementById('fc-card').classList.remove('flipped');
            document.getElementById('fc-category').innerText = card.category;
            document.getElementById('fc-def').innerText = card.def;
            document.getElementById('fc-term').innerText = card.term;
            document.getElementById('fc-hook').innerHTML = `<strong>💡 Concept & Memory Hook:</strong> ${card.hook}`;
        } else {
            renderQuizQuestion();
        }
    }

    // Flashcard Functions
    function flipCard() {
        playSound('flip');
        document.getElementById('fc-card').classList.toggle('flipped');
    }

    function fcAnswer(knows) {
        if (knows) {
            playSound('correct');
            score++;
        } else {
            playSound('wrong');
        }

        currentIndex++;
        renderCurrentItem();
    }

    // Quiz Functions
    function renderQuizQuestion() {
        const item = activeDeck[currentIndex];
        document.getElementById('quiz-question').innerText = `[${item.category}] — ${item.def}`;
        document.getElementById('quiz-explanation').classList.add('hidden');
        document.getElementById('quiz-next-btn').classList.add('hidden');

        // Generate choices dynamically
        let choices = [item.term];
        let availableDistractors = rawData
            .map(d => d.term)
            .filter(t => t !== item.term);

        availableDistractors.sort(() => 0.5 - Math.random());
        choices.push(...availableDistractors.slice(0, 3));
        choices.sort(() => 0.5 - Math.random());

        const container = document.getElementById('quiz-options');
        container.innerHTML = '';

        choices.forEach(choice => {
            const btn = document.createElement('button');
            btn.className = 'quiz-option';
            btn.innerText = choice;
            btn.onclick = () => handleQuizChoice(btn, choice, item);
            container.appendChild(btn);
        });
    }

    function handleQuizChoice(selectedBtn, choice, item) {
        const options = document.querySelectorAll('.quiz-option');
        options.forEach(opt => opt.onclick = null); // disable further selection

        if (choice === item.term) {
            playSound('correct');
            selectedBtn.classList.add('correct');
            score++;
        } else {
            playSound('wrong');
            selectedBtn.classList.add('incorrect');
            options.forEach(opt => {
                if (opt.innerText === item.term) opt.classList.add('correct');
            });
        }

        document.getElementById('quiz-hook-text').innerText = `${item.term}: ${item.hook}`;
        document.getElementById('quiz-explanation').classList.remove('hidden');
        document.getElementById('quiz-next-btn').classList.remove('hidden');
    }

    function nextQuizQuestion() {
        playSound('click');
        currentIndex++;
        renderCurrentItem();
    }

    function getMotivationalQuote(pct, name) {
        if (pct >= 85) {
            return {
                title: "🏛️ Master Structural Engineer in the Making!",
                message: `Outstanding performance, <strong>${name}</strong>! Your structural mastery is rock solid. Just like a well-designed ductile frame, you have built a strong, resilient foundation capable of handling high loads under pressure.`
            };
        } else if (pct >= 60) {
            return {
                title: "🏗️ Building a Strong Structural Foundation!",
                message: `Solid effort, future <strong>Engr. ${name}</strong>! Engineering design is an iterative process. Review the few concepts you missed, reinforce your weak joints, and take another pass.`
            };
        } else {
            return {
                title: "🌉 Deep Foundations Take Time to Pour!",
                message: `Keep pushing, <strong>${name}</strong>! Don't be discouraged by initial setbacks—even high-strength concrete takes time to cure. Engineering mastery comes through repetition and analysis of failure modes.`
            };
        }
    }

    function finishSession() {
        stopTimer();
        document.getElementById('screen-study').classList.add('hidden');
        document.getElementById('screen-summary').classList.remove('hidden');

        const percentage = Math.round((score / activeDeck.length) * 100);
        document.getElementById('summary-greeting').innerText = `Session Complete!`;
        document.getElementById('summary-score').innerText = `${percentage}% (${score}/${activeDeck.length})`;
        document.getElementById('summary-time').innerText = formatTime(secondsElapsed);

        // Motivational Words Generation
        const motivation = getMotivationalQuote(percentage, userName);
        document.getElementById('summary-motivation').innerHTML = `
            <h3>${motivation.title}</h3>
            <p>${motivation.message}</p>
            <div class="final-quote">
                "Trust your hard work, believe in yourself, and give it everything you’ve got. This exam is just one step toward the dream you’ve worked so hard for.<br><br>
                <strong>You will pass. You will be a Licensed Civil Engineer. Your “Engr.” is waiting for you. 🏗️</strong>"
            </div>
        `;
    }

    function exitSession() {
        stopTimer();
        playSound('click');
        document.getElementById('screen-study').classList.add('hidden');
        document.getElementById('screen-summary').classList.add('hidden');
        document.getElementById('screen-setup').classList.remove('hidden');
    }
</script>
