        { term: "Focus (Hypocenter)", def: "The underground earthquake origin point where fault slip begins.", category: "Seismic Engineering", hook: "DEEP underground initial fracture point (Hypo = below)." },
        { term: "Epicenter", def: "The point on the earth's surface directly vertically above the focus.", category: "Seismic Engineering", hook: "Map location directly above underground focus." },
        { term: "Story Drift Ratio", def: "Story drift divided by the story height.", category: "Structural Dynamics", hook: "Normalized drift angle (Drift / Height)." },
        { term: "Intensity", def: "Measure of earthquake shaking strength based on observed damage and human perception.", category: "Seismic Engineering", hook: "Qualitative damage rating (e.g., Mercalli scale)." },
        { term: "Magnitude", def: "Measure of total energy released at the earthquake source (Richter Scale).", category: "Seismic Engineering", hook: "Quantitative energy measurement number." },
        { term: "Liquefaction", def: "Loss of shear strength in saturated cohesionless soil causing it to behave like liquid during shaking.", category: "Geotechnical / Seismic", hook: "Quick-sand effect during earthquake shaking!" },
