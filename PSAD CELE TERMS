        { term: "Shear Drift", def: "Sideways building deflection caused primarily by lateral shear loads.", category: "Structural Dynamics", hook: "Racking deformation of frame panels." },
        { term: "Chord Drift", def: "Sideways building deflection caused by axial extension/compression of boundary columns.", category: "Structural Dynamics", hook: "Flexural bending deflection of tall slender towers." },
        { term: "Soft Storey", def: "Stiffness irregularity where storey lateral stiffness is < 70% of storey above or < 80% of avg of 3 above.", category: "Vertical Irregularities", hook: "Remember 70/80 Stiffness Rule!" },
        { term: "Weight (Mass) Irregularity", def: "Exists when effective mass of any storey is > 150% of an adjacent storey.", category: "Vertical Irregularities", hook: "Heavy floor! > 1.5x mass of adjacent floor." },
        { term: "Vertical Geometric Irregularity", def: "Exists when horizontal dimension of lateral system in any storey is > 130% of adjacent storey.", category: "Vertical Irregularities", hook: "Setback rule! > 1.3x dimension jump." },
        { term: "In-Plane Discontinuity Irregularity", def: "In-plane offset of lateral load resisting elements greater than length of element.", category: "Vertical Irregularities", hook: "Shear wall jumping sideways inside its plane." },
        { term: "Weak Storey", def: "Capacity irregularity where storey strength is < 80% of strength in storey above.", category: "Vertical Irregularities", hook: "Strength rule! < 80% load capacity above." },
