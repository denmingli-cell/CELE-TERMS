        { term: "Rigidity of a Structure", def: "The inverse or reciprocal of deflection.", category: "Structural Dynamics", hook: "High rigidity = Tiny deflection under load." },
        { term: "Story", def: "The space or height enclosed between two adjacent floor levels.", category: "Structural Systems", hook: "A single floor elevation level in a building." },
