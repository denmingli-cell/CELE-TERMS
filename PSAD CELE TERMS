        { term: "Eccentricity", def: "The distance between the Center of Rigidity and Center of Mass.", category: "Structural Dynamics", hook: "Offset distance causing building twist (Torsion)." },
        { term: "Design Seismic Base Shear", def: "The total estimated lateral force acting at the base of a structure.", category: "Seismic Engineering", hook: "Total lateral force the foundations must withstand." },
        { term: "Flexibility of a Structure", def: "The inverse or reciprocal of stiffness (f = 1/k).", category: "Structural Dynamics", hook: "High flexibility = easily deformed under load." },
        { term: "Story Drift", def: "The lateral displacement of one floor level relative to the level above or below.", category: "Structural Dynamics", hook: "Relative sideways tilt between floor 2 and floor 3." },
        { term: "Story Displacement", def: "Absolute lateral displacement of a story level relative to the ground base.", category: "Structural Dynamics", hook: "Total drift measured all the way from the ground up." },
